{
  "menu": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Mi Mini Arcade</title>\n  <style>\n    * { box-sizing: border-box; }\n    body { margin: 0; padding: 28px 20px; background: #101225; color: #f5f7ff; font-family: system-ui, sans-serif; }\n    main { max-width: 760px; margin: auto; }\n    .etiqueta { color: #63eed4; letter-spacing: .12em; font-size: .78rem; font-weight: 800; }\n    h1 { font-size: clamp(2rem, 7vw, 3.6rem); margin: 12px 0; line-height: 1.05; }\n    .intro { color: #c2c7e2; line-height: 1.65; max-width: 600px; }\n    .juegos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 30px; }\n    article { padding: 25px; background: #1c2140; border: 1px solid #3b4266; border-radius: 20px; }\n    .icono { font-size: 2.4rem; }\n    h2 { margin-bottom: 8px; }\n    article p { color: #c2c7e2; line-height: 1.6; }\n    button { min-height: 46px; padding: 12px 20px; border: 0; border-radius: 12px; background: #63eed4; color: #101225; font: inherit; font-weight: 800; cursor: pointer; }\n    button:focus-visible { outline: 3px solid white; outline-offset: 4px; }\n    footer { margin-top: 30px; color: #c2c7e2; font-size: .85rem; }\n    @media (max-width: 480px) { .juegos { grid-template-columns: 1fr; } }\n  </style>\n</head>\n<body>\n  <main>\n    <p class=\"etiqueta\">PROYECTO FINAL · DOS JUEGOS, UNA IDEA</p>\n    <!-- MISIÓN 1: cambia el título por un nombre propio de al menos 4 caracteres. -->\n    <h1>Órbita Arcade</h1>\n    <!-- MISIÓN 2: explica AMBOS juegos en al menos 35 caracteres. Conserva id=\"descripcion\". -->\n    <p id=\"descripcion\" class=\"intro\">Guía la culebrita con las flechas para comer y sumar puntos. Después descubre dos cartas a la vez hasta encontrar las seis parejas.</p>\n    <div class=\"juegos\">\n      <article>\n        <span class=\"icono\" aria-hidden=\"true\">🐍</span>\n        <h2>La culebrita</h2>\n        <p>Guía a la culebrita hasta la comida. Cada comida suma 10 puntos. ¡Evita las paredes y tu propio cuerpo!</p>\n        <!-- La conexión ya está lista. Conserva data-vista. -->\n        <button type=\"button\" data-vista=\"culebrita\">Jugar culebrita →</button>\n      </article>\n      <article>\n        <span class=\"icono\" aria-hidden=\"true\">🃏</span>\n        <h2>Encuentra las parejas</h2>\n        <p>Descubre dos cartas por turno. Cada pareja suma 20 puntos. Encuentra las seis parejas para ganar.</p>\n        <button type=\"button\" data-vista=\"memoria\">Jugar memoria →</button>\n      </article>\n    </div>\n    <footer>Creado por mí en CodePlay. Los puntos de estas partidas son temporales.</footer>\n  </main>\n</body>\n</html>\n",
  "culebrita": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>La culebrita</title>\n  <style>\n    * { box-sizing: border-box; }\n    body { margin: 0; padding: 20px; color: #f5f7ff; background: #101225; font-family: system-ui, sans-serif; }\n    main { max-width: 520px; margin: auto; }\n    header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n    h1 { margin: 25px 0 8px; font-size: clamp(1.7rem, 6vw, 2.4rem); }\n    .guia { line-height: 1.6; color: #c2c7e2; }\n    button { min-height: 44px; padding: 10px 16px; border: 1px solid #475074; border-radius: 12px; background: #242b4b; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }\n    button:focus-visible, canvas:focus-visible { outline: 3px solid #63eed4; outline-offset: 3px; }\n    .puntaje { color: #63eed4; font-weight: 800; white-space: nowrap; }\n    canvas { display: block; width: 100%; max-width: 432px; aspect-ratio: 1; margin: 20px auto; border: 2px solid #475074; border-radius: 12px; background: #171c34; }\n    #iniciar { background: #63eed4; color: #101225; border: none; }\n    #mensaje { min-height: 3em; line-height: 1.5; color: #d5dcf8; }\n    .controles { display: grid; grid-template-columns: repeat(3, 52px); gap: 6px; justify-content: center; margin: 15px 0; }\n    .controles button:first-child { grid-column: 2; }\n    .controles button:nth-child(2) { grid-column: 1; }\n    .acciones { text-align: center; }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <button type=\"button\" data-vista=\"menu\">← Menú</button>\n      <span class=\"puntaje\">Puntos: <span id=\"puntos\">0</span></span>\n    </header>\n    <h1>🐍 La culebrita</h1>\n    <p class=\"guia\">Usa las flechas o los botones. Come el cuadrado rosa para crecer y sumar 10 puntos. Pierdes si chocas con una pared o contigo mismo.</p>\n    <canvas id=\"tableroSerpiente\" width=\"432\" height=\"432\" tabindex=\"0\" aria-label=\"Tablero de culebrita de 12 por 12 casillas\"></canvas>\n    <div class=\"acciones\"><button id=\"iniciar\" type=\"button\">Iniciar / Reiniciar</button></div>\n    <div class=\"controles\" aria-label=\"Dirección de la culebrita\">\n      <button type=\"button\" data-direccion=\"arriba\" aria-label=\"Arriba\">↑</button>\n      <button type=\"button\" data-direccion=\"izquierda\" aria-label=\"Izquierda\">←</button>\n      <button type=\"button\" data-direccion=\"abajo\" aria-label=\"Abajo\">↓</button>\n      <button type=\"button\" data-direccion=\"derecha\" aria-label=\"Derecha\">→</button>\n    </div>\n    <p id=\"mensaje\" role=\"status\" aria-live=\"polite\">Completa las tres funciones y pulsa Iniciar.</p>\n  </main>\n  <script>\n    // =====================================================\n    // TU ZONA DE TRABAJO: completa estas TRES funciones.\n    // Cambia cada \"return null;\" por una única expresión return.\n    // No necesitas variables, bucles ni if dentro de estas funciones.\n    // El resto del juego ya está preparado como ayuda.\n    // =====================================================\n\n    // 1. Devuelve un NUEVO objeto con la próxima posición.\n    // cabeza y direccion tienen x e y. Ejemplo:\n    // {x: 4, y: 3} + {x: 1, y: 0} debe dar {x: 5, y: 3}.\n    function siguienteCabeza(cabeza, direccion) {\n      // TODO: suma cada coordenada y devuelve {x: ..., y: ...}.\n      return { x: cabeza.x + direccion.x, y: cabeza.y + direccion.y };\n    }\n\n    // 2. Devuelve true fuera del tablero y false dentro.\n    // Si limite es 12, las coordenadas válidas van de 0 a 11.\n    function chocaConPared(cabeza, limite) {\n      // TODO: comprueba x e y con < 0 y >= limite. Une con ||.\n      return cabeza.x < 0 || cabeza.x >= limite || cabeza.y < 0 || cabeza.y >= limite;\n    }\n\n    // 3. Devuelve los puntos actuales más 10.\n    function puntosPorComida(puntos) {\n      // TODO: devuelve una suma; puntos es un número.\n      return puntos + 10;\n    }\n\n    // =====================================================\n    // MOTOR ENTREGADO: dibuja, mueve, crece y reinicia.\n    // No necesitas modificarlo para resolver las misiones.\n    // =====================================================\n    const canvas = document.getElementById('tableroSerpiente');\n    const contexto = canvas.getContext('2d');\n    const limite = 12;\n    const casilla = canvas.width / limite;\n    const mensaje = document.getElementById('mensaje');\n    const puntosTexto = document.getElementById('puntos');\n    const direcciones = {\n      arriba: {x: 0, y: -1}, abajo: {x: 0, y: 1},\n      izquierda: {x: -1, y: 0}, derecha: {x: 1, y: 0}\n    };\n    let cuerpo = [];\n    let direccion = direcciones.derecha;\n    let siguienteDireccion = direccion;\n    let comida = {x: 7, y: 5};\n    let puntos = 0;\n    let intervalo = null;\n    let jugando = false;\n\n    function mismaCasilla(a, b) { return a.x === b.x && a.y === b.y; }\n\n    function dibujar() {\n      contexto.fillStyle = '#171c34';\n      contexto.fillRect(0, 0, canvas.width, canvas.height);\n      contexto.strokeStyle = '#242b49';\n      for (let i = 0; i <= limite; i++) {\n        contexto.beginPath();\n        contexto.moveTo(i * casilla, 0);\n        contexto.lineTo(i * casilla, canvas.height);\n        contexto.moveTo(0, i * casilla);\n        contexto.lineTo(canvas.width, i * casilla);\n        contexto.stroke();\n      }\n      contexto.fillStyle = '#ff7faf';\n      contexto.fillRect(comida.x * casilla + 6, comida.y * casilla + 6, casilla - 12, casilla - 12);\n      cuerpo.forEach((parte, indice) => {\n        contexto.fillStyle = indice === 0 ? '#c5fff3' : '#63eed4';\n        contexto.fillRect(parte.x * casilla + 3, parte.y * casilla + 3, casilla - 6, casilla - 6);\n      });\n    }\n\n    function detener(texto) {\n      clearInterval(intervalo);\n      intervalo = null;\n      jugando = false;\n      mensaje.textContent = texto;\n    }\n\n    function colocarComida() {\n      const libres = [];\n      for (let y = 0; y < limite; y++) {\n        for (let x = 0; x < limite; x++) {\n          if (!cuerpo.some(parte => mismaCasilla(parte, {x, y}))) libres.push({x, y});\n        }\n      }\n      if (!libres.length) {\n        detener('¡Llenaste el tablero! Puntuación: ' + puntos + '.');\n        return;\n      }\n      comida = libres[Math.floor(Math.random() * libres.length)];\n    }\n\n    function paso() {\n      direccion = siguienteDireccion;\n      let nueva, pared;\n      try {\n        nueva = siguienteCabeza({...cuerpo[0]}, {...direccion});\n        if (!nueva || !Number.isInteger(nueva.x) || !Number.isInteger(nueva.y)) {\n          detener('Revisa siguienteCabeza: debe devolver un objeto con x e y numéricos.');\n          return;\n        }\n        pared = chocaConPared(nueva, limite);\n        if (typeof pared !== 'boolean') {\n          detener('Completa chocaConPared: devuelve true o false.');\n          return;\n        }\n      } catch (error) {\n        detener('Revisa tus funciones: ' + error.message);\n        return;\n      }\n      if (pared || nueva.x < 0 || nueva.y < 0 || nueva.x >= limite || nueva.y >= limite) {\n        detener('Fin de la partida: chocaste con la pared. Puntos: ' + puntos + '.');\n        return;\n      }\n      const comio = mismaCasilla(nueva, comida);\n      const obstaculos = comio ? cuerpo : cuerpo.slice(0, -1);\n      if (obstaculos.some(parte => mismaCasilla(parte, nueva))) {\n        detener('Fin de la partida: chocaste con tu cuerpo. Puntos: ' + puntos + '.');\n        return;\n      }\n      cuerpo.unshift(nueva);\n      if (comio) {\n        try {\n          const nuevoPuntaje = puntosPorComida(puntos);\n          if (!Number.isFinite(nuevoPuntaje)) throw new Error('puntosPorComida debe devolver un número.');\n          puntos = nuevoPuntaje;\n          puntosTexto.textContent = puntos;\n          colocarComida();\n        } catch (error) {\n          detener('Revisa puntosPorComida: ' + error.message);\n          return;\n        }\n      } else {\n        cuerpo.pop();\n      }\n      dibujar();\n    }\n\n    function cambiarDireccion(nombre) {\n      const nueva = direcciones[nombre];\n      // Compara con la dirección del último paso: no permite girar 180°.\n      if (nueva && !(nueva.x === -direccion.x && nueva.y === -direccion.y)) siguienteDireccion = nueva;\n    }\n\n    function preparar() {\n      clearInterval(intervalo);\n      jugando = false;\n      puntos = 0;\n      puntosTexto.textContent = puntos;\n      cuerpo = [{x: 4, y: 5}, {x: 3, y: 5}, {x: 2, y: 5}];\n      direccion = direcciones.derecha;\n      siguienteDireccion = direccion;\n      comida = {x: 7, y: 5};\n      dibujar();\n    }\n\n    document.getElementById('iniciar').addEventListener('click', () => {\n      preparar();\n      jugando = true;\n      mensaje.textContent = '¡En marcha! Las flechas o los botones cambian la dirección.';\n      canvas.focus();\n      intervalo = setInterval(paso, 320);\n    });\n    document.addEventListener('keydown', evento => {\n      const teclas = {ArrowUp: 'arriba', ArrowDown: 'abajo', ArrowLeft: 'izquierda', ArrowRight: 'derecha'};\n      if (teclas[evento.key]) {\n        evento.preventDefault();\n        if (jugando) cambiarDireccion(teclas[evento.key]);\n      }\n    });\n    document.querySelectorAll('[data-direccion]').forEach(boton => {\n      boton.addEventListener('click', () => cambiarDireccion(boton.dataset.direccion));\n    });\n    preparar();\n  </script>\n</body>\n</html>\n",
  "memoria": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Encuentra las parejas</title>\n  <style>\n    * { box-sizing: border-box; }\n    body { margin: 0; padding: 20px; color: #f5f7ff; background: #101225; font-family: system-ui, sans-serif; }\n    main { max-width: 520px; margin: auto; }\n    header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n    h1 { margin: 25px 0 8px; font-size: clamp(1.65rem, 6vw, 2.3rem); }\n    .guia { color: #c2c7e2; line-height: 1.6; }\n    button { min-height: 44px; padding: 10px 16px; border: 1px solid #475074; border-radius: 12px; background: #242b4b; color: white; font: inherit; font-weight: 700; cursor: pointer; }\n    button:focus-visible { outline: 3px solid #63eed4; outline-offset: 3px; }\n    .puntaje { color: #63eed4; font-weight: 800; }\n    #tableroMemoria { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin: 24px 0; }\n    .carta { aspect-ratio: 1; padding: 0; min-width: 0; font-size: clamp(1.5rem, 7vw, 2.4rem); background: #343264; }\n    .carta.abierta { background: #f4f0ff; color: #222; }\n    .carta.encontrada { background: #174f48; border-color: #63eed4; opacity: 1; }\n    #reiniciar { background: #63eed4; color: #101225; border: 0; }\n    #mensaje { min-height: 3em; line-height: 1.5; }\n    .estado { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; color: #c2c7e2; }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <button type=\"button\" data-vista=\"menu\">← Menú</button>\n      <span class=\"puntaje\">Puntos: <span id=\"puntos\">0</span></span>\n    </header>\n    <h1>🃏 Encuentra las parejas</h1>\n    <p class=\"guia\">Descubre dos cartas. Si son iguales, ganas 20 puntos; si son distintas, vuelven a ocultarse. Encuentra las 6 parejas del tablero de 3 filas y 4 columnas.</p>\n    <div id=\"tableroMemoria\" aria-label=\"Tablero de memoria: tres filas y cuatro columnas\"></div>\n    <div class=\"estado\">\n      <span>Parejas: <span id=\"parejas\">0</span> / 6</span>\n      <button id=\"reiniciar\" type=\"button\">Reiniciar partida</button>\n    </div>\n    <p id=\"mensaje\" role=\"status\" aria-live=\"polite\">Completa las tres funciones y prueba las cartas.</p>\n  </main>\n  <script>\n    // =====================================================\n    // TU ZONA DE TRABAJO: completa estas TRES funciones.\n    // Cambia cada \"return null;\" por una única expresión return.\n    // No necesitas variables, bucles ni if dentro de estas funciones.\n    // Recibes valores sencillos, no elementos HTML.\n    // =====================================================\n\n    // 1. primera y segunda son textos como \"🍒\" y \"🍒\".\n    // Devuelve true si son iguales; false si son diferentes.\n    function sonPareja(primera, segunda) {\n      // TODO: compara ambos valores con ===.\n      return primera === segunda;\n    }\n\n    // 2. Cada pareja encontrada vale 20 puntos.\n    function puntosPorPareja(puntos) {\n      // TODO: devuelve los puntos actuales más 20.\n      return puntos + 20;\n    }\n\n    // 3. Devuelve true cuando parejas sea 6; false antes.\n    function partidaTerminada(parejas) {\n      // TODO: compara el número de parejas con 6.\n      return parejas === 6;\n    }\n\n    // =====================================================\n    // MOTOR ENTREGADO: mezcla, descubre, oculta y reinicia.\n    // =====================================================\n    const tablero = document.getElementById('tableroMemoria');\n    const mensaje = document.getElementById('mensaje');\n    const puntosTexto = document.getElementById('puntos');\n    const parejasTexto = document.getElementById('parejas');\n    const simbolos = ['🍒', '🚀', '🌈', '🐸', '⭐', '🎮'];\n    let primeraCarta = null;\n    let bloqueado = false;\n    let puntos = 0;\n    let parejas = 0;\n    let espera = null;\n\n    function mezclar(cartas) {\n      for (let i = cartas.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        [cartas[i], cartas[j]] = [cartas[j], cartas[i]];\n      }\n      return cartas;\n    }\n\n    function ocultar(carta) {\n      carta.textContent = '?';\n      carta.classList.remove('abierta');\n      carta.setAttribute('aria-label', 'Carta oculta ' + carta.dataset.indice);\n    }\n\n    function elegir(carta) {\n      if (bloqueado || carta === primeraCarta || carta.disabled) return;\n      carta.textContent = carta.dataset.valor;\n      carta.classList.add('abierta');\n      carta.setAttribute('aria-label', 'Carta ' + carta.dataset.valor);\n      if (!primeraCarta) {\n        primeraCarta = carta;\n        mensaje.textContent = 'Elige otra carta.';\n        return;\n      }\n      bloqueado = true;\n      const anterior = primeraCarta;\n      primeraCarta = null;\n      try {\n        const coinciden = sonPareja(anterior.dataset.valor, carta.dataset.valor);\n        if (typeof coinciden !== 'boolean') throw new Error('sonPareja debe devolver true o false.');\n        if (coinciden) {\n          const nuevosPuntos = puntosPorPareja(puntos);\n          const termino = partidaTerminada(parejas + 1);\n          if (!Number.isFinite(nuevosPuntos)) throw new Error('puntosPorPareja debe devolver un número.');\n          if (typeof termino !== 'boolean') throw new Error('partidaTerminada debe devolver true o false.');\n          puntos = nuevosPuntos;\n          parejas++;\n          puntosTexto.textContent = puntos;\n          parejasTexto.textContent = parejas;\n          [anterior, carta].forEach(encontrada => {\n            encontrada.disabled = true;\n            encontrada.classList.add('encontrada');\n          });\n          bloqueado = termino;\n          mensaje.textContent = termino\n            ? '¡Encontraste todas las parejas! Ganaste ' + puntos + ' puntos.'\n            : '¡Pareja encontrada! Sigue buscando.';\n        } else {\n          mensaje.textContent = 'Son diferentes. Recuerda sus posiciones.';\n          espera = setTimeout(() => {\n            ocultar(anterior);\n            ocultar(carta);\n            bloqueado = false;\n            espera = null;\n          }, 850);\n        }\n      } catch (error) {\n        ocultar(anterior);\n        ocultar(carta);\n        bloqueado = false;\n        mensaje.textContent = 'Completa tus funciones: ' + error.message;\n      }\n    }\n\n    function reiniciar() {\n      clearTimeout(espera);\n      espera = null;\n      primeraCarta = null;\n      bloqueado = false;\n      puntos = 0;\n      parejas = 0;\n      puntosTexto.textContent = puntos;\n      parejasTexto.textContent = parejas;\n      tablero.replaceChildren();\n      mezclar([...simbolos, ...simbolos]).forEach((simbolo, indice) => {\n        const carta = document.createElement('button');\n        carta.type = 'button';\n        carta.className = 'carta';\n        carta.dataset.valor = simbolo;\n        carta.dataset.indice = indice + 1;\n        ocultar(carta);\n        carta.addEventListener('click', () => elegir(carta));\n        tablero.appendChild(carta);\n      });\n      mensaje.textContent = 'Descubre dos cartas. Completa las funciones si todavía no lo has hecho.';\n    }\n\n    document.getElementById('reiniciar').addEventListener('click', reiniciar);\n    reiniciar();\n  </script>\n</body>\n</html>\n"
}
